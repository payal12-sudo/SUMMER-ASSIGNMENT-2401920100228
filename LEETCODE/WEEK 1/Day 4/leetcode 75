class Solution {
public:
    void sortColors(vector<int>& a) {
        int l=0;
        int mid=0;
        int h=a.size()-1;

        while(mid<=h){
            if(a[mid]==0){
                swap(a[mid],a[l]);
                    l++;
                    mid++;
                
            }
            else if(a[mid]==1){
                mid++;
            }
            else{
                swap(a[mid],a[h]);
                h--;
            }

            
        }
    }
};


