class Solution {
public:
    bool isValid(string s) {
        map<char, char> m = {
            {'(', ')'},
            {'{', '}'},
            {'[', ']'}
        };

        stack<char> st;

        for (char c : s) {

            
            if (m.count(c)) {
                st.push(c);
            }
           
            else {
                if (st.empty()) return false;

                char top = st.top();
                st.pop();

                if (m[top] != c) return false;
            }
        }

        return st.empty();
    }
};
